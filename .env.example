# ============================================================================
# AfriVPS environment configuration
# Copy to `.env.local` and fill in values. NEVER commit real secrets.
# ============================================================================

# ---- App ----
# Public base URL of the app.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Firebase Web SDK (safe to expose to the browser) ----
# When running fully against the Firebase Emulator Suite you can use a
# `demo-` prefixed project id and dummy values; the emulators never touch a
# real project. For a real project, copy values from the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-afrivps.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-afrivps
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-afrivps.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ---- Firebase Emulator Suite ----
# Set to "true" to point BOTH the web SDK and Admin SDK at local emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Emulator hosts (defaults shown). Used by client + admin + tests + seed.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---- Firebase Admin SDK (server-only — NEVER prefix with NEXT_PUBLIC_) ----
# Required only when NOT using emulators. Keep the private key secret.
FIREBASE_PROJECT_ID=demo-afrivps
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@demo-afrivps.iam.gserviceaccount.com
# Use quotes and literal \n for newlines when pasting a service-account key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Email (Resend) — optional for Phase 1 ----
RESEND_API_KEY=

# ---- Session ----
# Session cookie lifetime in days (Firebase max is 14).
SESSION_COOKIE_DAYS=5
