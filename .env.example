# ============================================================================
# AfriVPS environment configuration
# Copy to `.env.local` and fill in values. NEVER commit real secrets.
# ============================================================================

# ---- App ----
# Public base URL of the app.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Firebase Web SDK (safe to expose to the browser) ----
# When running fully against the Firebase Emulator Suite you can use a
# `demo-` prefixed project id and dummy values; the emulators never touch a
# real project. For a real project, copy values from the Firebase console.
# The entire Web SDK config (including apiKey) is PUBLIC by design and safe in
# the browser bundle / NEXT_PUBLIC_* — it identifies the project, it is not a
# secret. The example below shows the live `afri-vps` project values.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDd4EtPc4kJr_BMrn0t-RDi4R5xoWVaOjM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=afri-vps.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=afri-vps
# New-style bucket domain for `afri-vps` (note: *.firebasestorage.app).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=afri-vps.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=188021762578
NEXT_PUBLIC_FIREBASE_APP_ID=1:188021762578:web:4add113a7a01554d0046cb
# Optional — only used to enable Firebase Analytics in the browser. Leave unset
# to disable analytics. Ignored entirely in emulator mode.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-JV6Q33R6L1

# ---- Firebase Emulator Suite ----
# Set to "true" to point BOTH the web SDK and Admin SDK at local emulators
# (default local-dev workflow — no real project touched, Admin creds optional).
# Set to "false" to run against the live `afri-vps` project; you must then
# provide the server-only Admin SDK credentials below.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Emulator hosts (defaults shown). Used by client + admin + tests + seed.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---- Firebase Admin SDK (server-only — NEVER prefix with NEXT_PUBLIC_) ----
# Required only when NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false. These come from a
# service-account JSON for the live project. The PRIVATE KEY is a SECRET —
# provide it via Cursor Secrets / deployment env and NEVER commit it. For the
# live project set FIREBASE_PROJECT_ID=afri-vps and the matching service account.
FIREBASE_PROJECT_ID=afri-vps
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@afri-vps.iam.gserviceaccount.com
# Use quotes and literal \n for newlines when pasting a service-account key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Email (Resend) — optional for Phase 1 ----
RESEND_API_KEY=

# ---- Session ----
# Session cookie lifetime in days (Firebase max is 14).
SESSION_COOKIE_DAYS=5
